<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>avformat</ProjectName>
    <RootNamespace>avformat</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)ffmpeg-compiler.props" />
  <Import Project="$(MSBuildThisFileDirectory)$(FFmpegCompiler)\items-avformat-$(Platform).props" />
  <Import Project="$(MSBuildThisFileDirectory)ffmpeg.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)ffmpeg-linker.props" />
  <ItemGroup>
    <ClCompile Remove="$(FFmpegSrc)libavformat\mov.c" />
    <ClCompile Include="$(IntDir)patched\libavformat\mov.c">
      <ObjectFileName>$(IntDir)libavformat\mov.obj</ObjectFileName>
      <AdditionalIncludeDirectories>$(FFmpegSrc)libavformat;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>
  <Target Name="PatchMp4KeyframeSeeking" BeforeTargets="ClCompile"
          Inputs="$(FFmpegSrc)libavformat\mov.c;$(MSBuildThisFileDirectory)mp4-keyframe-seeking.patch;$(MSBuildProjectFullPath)"
          Outputs="$(IntDir)patched\libavformat\mov.c;$(IntDir)patched\applied.stamp">
    <MakeDir Directories="$(IntDir)patched\libavformat" />
    <Copy SourceFiles="$(FFmpegSrc)libavformat\mov.c" DestinationFiles="$(IntDir)patched\libavformat\mov.c" />
    <Exec WorkingDirectory="$(MpcRoot)" Command="git apply --verbose --unsafe-paths --directory=&quot;$(IntDir)patched&quot; &quot;$(MSBuildThisFileDirectory)mp4-keyframe-seeking.patch&quot;" />
    <Touch Files="$(IntDir)patched\applied.stamp" AlwaysCreate="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)avutil.vcxproj"><LinkLibraryDependencies>false</LinkLibraryDependencies></ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)avcodec.vcxproj"><LinkLibraryDependencies>false</LinkLibraryDependencies></ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)swresample.vcxproj"><LinkLibraryDependencies>false</LinkLibraryDependencies></ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\libs\libxml2\libxml2.vcxproj"><LinkLibraryDependencies>false</LinkLibraryDependencies></ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
